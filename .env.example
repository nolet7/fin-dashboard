# FinanceHub Environment Configuration
# Copy this file to .env and update with your actual values
# For Kubernetes deployments, these values come from Secrets/ConfigMaps

# Application Configuration
NODE_ENV=development
APP_PORT=3000
DEV_PORT=5173
API_URL=http://localhost:3001

# Database Configuration (External PostgreSQL)
# Connection string format: postgresql://admin:<PASSWORD>@<DB_HOST>:5432/financehub
# For local development, replace with actual values
# For Kubernetes, these come from financehub-db Secret
DB_HOST=<REPLACE_ME>
DB_PORT=5432
DB_NAME=financehub
DB_USER=admin
DB_PASSWORD=<REPLACE_ME>

# Security (for production)
JWT_SECRET=your_jwt_secret_key_here
BCRYPT_ROUNDS=10

# Optional: External API Keys
# EXCHANGE_API_KEY=your_exchange_rate_api_key
# NOTIFICATION_API_KEY=your_notification_service_key