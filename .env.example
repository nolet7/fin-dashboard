# FinanceHub Environment Configuration
# Copy this file to .env and update with your actual values

# Application Configuration
NODE_ENV=development
APP_PORT=3000
DEV_PORT=5173
API_URL=http://localhost:3001

# Database Configuration
DB_HOST=192.168.0.103
DB_PORT=5432
DB_NAME=financehub
DB_USER=your_username
DB_PASSWORD=your_password

# Optional: If using containerized PostgreSQL
# Set DB_HOST=postgres when using the containerized database
# DB_HOST=postgres

# Security (for production)
JWT_SECRET=your_jwt_secret_key_here
BCRYPT_ROUNDS=10

# Optional: External API Keys
# EXCHANGE_API_KEY=your_exchange_rate_api_key
# NOTIFICATION_API_KEY=your_notification_service_key